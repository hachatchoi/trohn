        <mxCell id="117" value="26: Chưa xác định đã lưu; kiểm tra&#10;trạng thái trước khi gửi lại" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#303030;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="162" y="2590" width="311" height="51" />
        </mxCell>
        <mxCell id="118" value="" style="edgeStyle=none;html=0;endArrow=open;endFill=0;strokeColor=#303030;strokeWidth=1;dashed=1;dashPattern=4 4;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="480" y="2651" />
            <mxPoint as="targetPoint" x="155" y="2651" />
          </mxGeometry>
        </mxCell>
        <mxCell id="119" value="" style="shape=rect;fillColor=#FFF8C6;strokeColor=#C9B66C;strokeWidth=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="2670" width="2840" height="48" />
        </mxCell>
        <mxCell id="120" value="Không có mũi tên trả về giả từ máy chủ trong nhánh mất phản hồi. Máy chủ có thể vẫn hoàn tất giao dịch. Tải lại đối tượng hoặc tra kết quả theo mã yêu cầu trước khi thực hiện lại." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#303030;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="82" y="2673" width="2816" height="42" />
        </mxCell>
        <mxCell id="121" value="" style="shape=rect;fillColor=#FFF8C6;strokeColor=#C9B66C;strokeWidth=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="2748" width="2840" height="48" />
        </mxCell>
        <mxCell id="122" value="Nhánh lỗi đọc minh họa tại Repository chính. Khi lỗi phát sinh ở Repository khác trên trang chính, chính đối tượng đó trả lỗi về Service theo cùng chuỗi. Với nhiều thao tác trong UnitOfWork, lỗi tại bất kỳ Repository hoặc COMMIT đều dừng xử lý; chỉ báo chưa lưu khi đã xác nhận rollback, nếu không phải báo chưa rõ kết quả." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#303030;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="82" y="2751" width="2816" height="42" />
        </mxCell>
        <mxCell id="123" value="" style="shape=rect;fillColor=#FFF8C6;strokeColor=#C9B66C;strokeWidth=1;rounded=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="2822" width="2850" height="53" />
        </mxCell>
        <mxCell id="124" value="Đóng biểu mẫu trước khi gửi: kết thúc mà chưa tạo thay đổi. Đóng sau khi đã gửi không chứng minh giao dịch bị hủy. Quyền phải được kiểm tra lại trước ghi; dữ liệu thay đổi đồng thời được xử lý theo nhánh nghiệp vụ của trang chính." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#303030;fontStyle=0;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="2825" width="2820" height="47" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
