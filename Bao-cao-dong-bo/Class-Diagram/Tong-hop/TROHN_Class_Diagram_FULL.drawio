        <mxCell id="p1_c28" value="DUYET_TIN&#10;TU_CHOI_TIN&#10;AN_TIN&#10;KHOA_TAI_KHOAN&#10;MO_KHOA_TAI_KHOAN" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#527FA2;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="p1_c26">
