          <mxGeometry as="geometry" x="0" y="215" width="700" height="40" />
        </mxCell>
        <mxCell id="c30" value="QUY TẮC BÁM ĐẶC TẢ&#10;UC13: sửa tin → CHO_DUYET; giữ lịch đã có.&#10;UC14/19: ẩn tin → hủy lịch tương lai còn hoạt động.&#10;UC20: khóa tài khoản, thu hồi phiên, hủy lịch tương lai; chỉ ẩn các tin đang hiển thị nếu mục tiêu là chủ trọ.&#10;UC21: không khôi phục phiên, lịch hoặc công khai tin.&#10;UC15: kiểm tra trùng THỜI ĐIỂM của chủ trọ; chưa có thời lượng lịch hẹn.&#10;Lịch hoạt động = CHO_XAC_NHAN hoặc DA_XAC_NHAN." style="shape=note;whiteSpace=wrap;html=0;fillColor=#FFF5CC;strokeColor=#C9AD55;fontSize=18;fontFamily=Arial;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="860" y="970" width="1490" height="300" />
        </mxCell>
        <mxCell id="c31" value="Quy tắc áp dụng cho bản chỉnh sửa UC14: CHO_DUYET/DANG_HIEN_THI → CHU_TRO_AN.&#10;CHU_TRO_AN: trả kết quả hiện có. Trạng thái khác: từ chối thay đổi.&#10;Mỗi tài khoản có một vai trò. nguoiHuy có thể trống khi hệ thống tự động hủy; nếu thao tác người dùng gây hủy thì ghi người đó.&#10;DonViTinhChiPhi dùng cho điện/nước/dịch vụ/gửi xe; không gộp số tiền và đơn vị thành chuỗi." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=12;shape=note;fillColor=#FFF5CC;strokeColor=#C9AD55;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="860" y="1390" width="1490" height="280" />
        </mxCell>
        <mxCell id="new_DonViTinhChiPhi" value="" style="rounded=0;fillColor=#FFFFFF;strokeColor=#527FA2;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1390" width="700" height="283" />
        </mxCell>
