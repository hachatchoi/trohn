        <mxCell id="c42" value="+ xacThuc(sessionId: String): ActorContext&#10;+ kiemTraVaiTro(actor: ActorContext, vaiTro: VaiTro): void" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#527FA2;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="c39">
