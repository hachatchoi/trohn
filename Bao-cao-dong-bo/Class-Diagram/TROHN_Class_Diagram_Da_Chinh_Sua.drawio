        <mxCell id="c34" value="Lấy tài khoản từ phiên, không tin userId do client gửi.&#10;&#10;Cặp khách thuê – tin là duy nhất. Thêm trùng trả trạng thái đã lưu; bỏ mục không tồn tại vẫn thành công.&#10;&#10;Tin ẩn vẫn được bỏ lưu. Danh sách đánh dấu không khả dụng, không trả nội dung riêng của tin ẩn.&#10;&#10;Ẩn tin không xóa quan hệ yêu thích." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=12;shape=note;fillColor=#FFF5CC;strokeColor=#C9AD55;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2670" y="2200" width="1080" height="370" />
        </mxCell>
        <mxCell id="c35" value="ActorContext được backend tạo từ phiên hợp lệ/SecurityContext; client không được quyết định actorId hay vai trò.&#10;Service kiểm tra trạng thái, quyền sở hữu và giao dịch. Controller nhận request/response; Repository thao tác Entity.&#10;Các Repository lặp ở nhiều trang là cùng một interface, mỗi trang chỉ trình bày phần phương thức liên quan." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=12;text;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="2650" width="3650" height="100" />
        </mxCell>
