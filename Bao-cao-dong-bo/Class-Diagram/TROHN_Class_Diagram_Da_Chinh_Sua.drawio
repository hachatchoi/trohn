        <mxCell id="c44" value="Kiểm tra chủ sở hữu và version khi sửa/duyệt.&#10;UC13 giữ lịch cũ, chuyển tin về chờ duyệt.&#10;UC14/19 hủy lịch tương lai trong giao dịch.&#10;UC17/18/19 lưu nhật ký.&#10;&#10;ImageStorage nằm ngoài giao dịch MySQL: cần dọn ảnh tạm/bù trừ khi lưu tin thất bại.&#10;&#10;GeoService tính khoảng cách theo cơ sở trường, không cố định theo tin." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=12;shape=note;fillColor=#FFF5CC;strokeColor=#C9AD55;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2670" y="2200" width="1080" height="370" />
        </mxCell>
        <mxCell id="c45" value="ActorContext được backend tạo từ phiên hợp lệ/SecurityContext; client không được quyết định actorId hay vai trò.&#10;Service kiểm tra trạng thái, quyền sở hữu và giao dịch. Controller nhận request/response; Repository thao tác Entity.&#10;Các Repository lặp ở nhiều trang là cùng một interface, mỗi trang chỉ trình bày phần phương thức liên quan." style="html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=12;text;fillColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1">
