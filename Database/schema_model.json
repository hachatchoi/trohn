        "Băm mật khẩu BCrypt; không trả qua API"
      ],
      [
        "vaiTro",
        "VARCHAR(20) NOT NULL",
        "KHACH_THUE CHU_TRO ADMIN"
      ],
      [
        "trangThai",
        "VARCHAR(20) NOT NULL DEFAULT 'HOAT_DONG'",
        "HOAT_DONG hoặc BI_KHOA"
      ],
      [
        "lyDoKhoa",
        "VARCHAR(1000) NULL",
        "Lý do khóa hiện tại; lịch sử ở nhật ký"
      ],
      [
        "ngayTao",
        "DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6)",
        "Thời điểm tạo UTC"
      ],
      [
        "ngayCapNhat",
        "DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6) ON UPDATE CURRENT_TIMESTAMP(6)",
        "Thời điểm cập nhật UTC"
      ],
      [
        "version",
        "BIGINT NOT NULL DEFAULT 0",
        "Phiên bản; ứng dụng tăng khi ghi, kể cả bulk update"
      ]
    ],
    [
      "UNIQUE KEY uk_email (email)",
      "CHECK (vaiTro IN ('KHACH_THUE','CHU_TRO','ADMIN'))",
      "CHECK (trangThai IN ('HOAT_DONG','BI_KHOA'))",
      "CHECK (version >= 0)",
      "CHECK (trangThai <> 'BI_KHOA' OR (lyDoKhoa IS NOT NULL AND CHAR_LENGTH(TRIM(lyDoKhoa)) > 0))"
    ]
  ],
